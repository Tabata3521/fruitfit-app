{
  "name": "fruitfit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "dev:vite": "vite --configLoader runner --host 0.0.0.0",
    "api": "node server.js",
    "db:nutrition:seed": "node scripts/seed-nutrition-db.js",
    "test:nutrition": "node scripts/test-nutrition.js",
    "audit:nutrition": "node scripts/audit-nutrition-plans.mjs",
    "test:engagement": "node scripts/test-engagement-prompts.mjs",
    "test:program-assignment": "node scripts/test-program-assignment-client.mjs",
    "test:auth": "node scripts/test-auth-recovery-client.mjs",
    "test:modals": "node scripts/test-modal-state-safety.mjs",
    "test:restrictions": "node scripts/test-restriction-multiselect.mjs",
    "test:ux": "node scripts/test-ux-release-patch.mjs",
    "test:ai-feedback": "node scripts/test-ai-feedback-client.mjs",
    "test:workout-sessions": "node scripts/test-workout-sessions.mjs",
    "test:attribution": "node scripts/test-attribution-client.mjs",
    "build:exercise-catalog": "node tools/import-didactic-exercises.mjs",
    "audit:muscle-templates": "node scripts/audit-muscle-templates.mjs",
    "audit:exercise-videos": "node scripts/audit-missing-exercise-videos.mjs",
    "export:youtube-exercises": "node scripts/export-youtube-exercises.js",
    "match:youtube-inskill": "node scripts/match-youtube-inskill-exercises.js",
    "build": "vite build --configLoader runner",
    "build:ios-review": "vite build --mode app-store --configLoader runner",
    "build:google-play": "vite build --mode google-play --configLoader runner",
    "verify:google-play-attribution": "node scripts/verify-google-play-attribution-build.mjs",
    "build:rustore": "vite build --mode rustore --configLoader runner",
    "build:huawei": "vite build --mode huawei --configLoader runner",
    "build:direct-apk": "vite build --mode direct-apk --configLoader runner",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "powershell -ExecutionPolicy Bypass -File scripts/sync-android.ps1",
    "ios:sync": "npm run build:ios-review && npx cap sync ios",
    "android:debug": "powershell -ExecutionPolicy Bypass -File scripts/build-android-debug.ps1",
    "android:huawei": "powershell -ExecutionPolicy Bypass -File scripts/build-huawei-debug.ps1"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/android": "8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "8.4.0",
    "@capacitor/ios": "8.4.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capgo/capacitor-health": "^8.6.6",
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^12.9.0",
    "cookie": "^1.1.1",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7",
    "youtubei.js": "^17.0.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.4.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "xlsx": "^0.18.5"

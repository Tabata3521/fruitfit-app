NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://fruitfit_app:change_me@127.0.0.1:5432/fruitfit
JWT_SECRET=change_me
COOKIE_SECRET=change_me
CORS_ORIGINS=https://admin.tagirfruit.ru,https://client.tagirfruit.ru,https://tagirfruit.ru
APP_PUBLIC_URL=https://client.tagirfruit.ru
APP_BASE_URL=https://client.tagirfruit.ru
SITE_BASE_URL=https://tagirfruit.ru
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WEBHOOK_SECRET=
OPENAI_INPUT_COST_PER_1M=
OPENAI_OUTPUT_COST_PER_1M=
OPENAI_BUDGET_USD=
TELEGRAM_BOT_TOKEN=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://api.tagirfruit.ru/api/auth/yandex/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.tagirfruit.ru/api/auth/google/callback
# SMTP for MVP email verification.
# Local Postfix outbound-only example:
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=FruitFit <noreply@tagirfruit.ru>
#
# Domain mailbox SMTP example:
# Example:
# SMTP_HOST=smtp.example.ru
# SMTP_PORT=465
# SMTP_USER=noreply@tagirfruit.ru
# SMTP_PASS=change_me
# SMTP_FROM=FruitFit <noreply@tagirfruit.ru>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
APP_VERSION_MANIFEST_PATH=/opt/fruitfit/backend/app-version.json
ADMIN_API_TOKEN=
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_TEST_PASSWORD_1=
ROBOKASSA_TEST_PASSWORD_2=
ROBOKASSA_HASH_ALGORITHM=md5
ROBOKASSA_TEST_MODE=true
ROBOKASSA_RECURRING_ENABLED=false
PROGRAM_PRICE_MODE=test
PROGRAM_PRICE_TEST=100
PROGRAM_PRICE_PROD=2990
PAYMENT_PROGRAM_ASSIGNMENT_DELAY_SECONDS=180
PAYMENT_ASSIGNMENT_WORKER_INTERVAL_SECONDS=30
PUSH_PROVIDER=fcm
FCM_PROJECT_ID=
# JSON service account or base64-encoded JSON. Backend only, never frontend.
FCM_SERVICE_ACCOUNT_JSON=
